# Copy to backend/.env and fill in. This one file configures both halves of MAYAMI:
# the backend reads all of it, and the extension build reads the MAYAMI_* lines as its defaults.

# --- Required ------------------------------------------------------------------------
# Gemini API key (aistudio.google.com). One key covers transcription (STT) and answers (LLM).
GOOGLE_API_KEY=

# Shared secret the extension must send (?token=...). Leave empty only for local dev.
MAYAMI_API_KEY=change-me

# --- Extension (frontend) defaults ---------------------------------------------------
# Where the extension connects. Use wss://your-host when the backend is behind HTTPS.
# MAYAMI_SERVER_URL=ws://localhost:8000

# --- Models --------------------------------------------------------------------------
STT_MODEL=gemini-3.5-transcribe-live
LLM_MODEL=gemini-3-flash-preview
LLM_FALLBACK_MODEL=gemini-3.5-flash
# How long to wait for LLM_MODEL before also asking LLM_FALLBACK_MODEL.
LLM_HEDGE_MS=2000
LLM_MAX_TOKENS=600
# 0 turns thinking off for the fastest first token.
LLM_THINKING_BUDGET=0

# --- Server --------------------------------------------------------------------------
# Local runs keep the vector store under backend/data; docker-compose overrides this with /data/chroma.
CHROMA_PATH=./data/chroma
CORS_ORIGINS=*

# --- Retrieval and question handling -------------------------------------------------
RESUME_TOP_K=4
JD_TOP_K=2
# Interviewer utterances shorter than this are treated as chatter, not questions.
MIN_QUESTION_WORDS=4
# Past transcript turns sent to the LLM as context.
HISTORY_TURNS=6
LISTENER_WAIT_MS=1200

# --- Coach ---------------------------------------------------------------------------
COACH_MONOLOGUE_SECONDS=180
COACH_FAST_WPM=175
COACH_COOLDOWN_SECONDS=60
