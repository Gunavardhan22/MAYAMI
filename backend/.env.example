# Required
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=

# Shared secret the extension must send (?token=...). Leave empty only for local dev.
MAYAMI_API_KEY=change-me

# Optional tuning
LLM_MODEL=claude-haiku-5-5
LLM_MAX_TOKENS=600
DEEPGRAM_MODEL=nova-3
UTTERANCE_END_MS=1000
MIN_QUESTION_WORDS=4
CHROMA_PATH=/data/chroma
CORS_ORIGINS=*
