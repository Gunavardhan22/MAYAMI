{
  "name": "mayami-desktop",
  "productName": "MAYAMI",
  "private": true,
  "version": "0.2.0",
  "description": "Real-time, resume-grounded answer suggestions during interviews, as a desktop app.",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "framer-motion": "14.6.0",
    "lucide-react": "1.61.0",
    "mermaid": "12.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-rnd": "10.5.3",
    "remark-gfm": "4.0.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@types/chrome": "0.3.6",
    "@types/node": "^24.9.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "10.6.1",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
