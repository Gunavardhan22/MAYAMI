{
  "manifest_version": 3,
  "name": "MAYAMI",
  "version": "0.1.0",
  "description": "Real-time, resume-grounded answer suggestions during browser-based interviews.",
  "minimum_chrome_version": "116",
  "permissions": ["tabCapture", "offscreen", "storage", "scripting", "activeTab"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "MAYAMI" },
  "options_page": "options.html"
}
